# ENACT - Docker Environment Variables
# Copy this file to .env and customize for your machine:
#   cp .env.example .env
# docker compose reads .env automatically from this directory.

# ============================================================================
# Data root (host machine)
# ============================================================================
# Single folder holding all ENACT data. Subfolders (created by
# scripts/setup_volumes.sh, or by unzipping the starter data pack):
#   rosbags/  -> /data/rosbags    (recorded demonstrations)
#   csvdata/  -> /data/processed  (CSVs, tensors, norm stats, processed URDFs)
#   models/   -> /data/models     (trained model checkpoints)
#   logs/     -> /data/logs       (training / tensorboard logs)
#
# Defaults to $HOME/enact_local if unset. To relocate, uncomment and use an
# ABSOLUTE path (no ~):
# ENACT_DATA=/absolute/path/to/enact_local

# ============================================================================
# Docker image tag (which published image version to run)
# ============================================================================
# "latest" tracks the newest release; pin a version (e.g. v1.0.0) for
# reproducibility.
ENACT_TAG=latest

# ============================================================================
# Robot / display
# ============================================================================
# TM12S robot IP on the robot network
ROBOT_IP=192.168.10.2

# X11 display for GUI applications (RViz, matplotlib)
DISPLAY=:0

# ============================================================================
# GPU / ROS2 (defaults are fine for a single-GPU machine)
# ============================================================================
CUDA_VISIBLE_DEVICES=0
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
