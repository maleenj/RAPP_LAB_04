<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vam_inference</name>
  <version>0.1.0</version>
  <description>Vision-Action Model inference node for UR10 robot mirroring</description>
  <maintainer email="maleen@rapplab.org">Maleen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>zed_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>moveit_msgs</depend>
  <exec_depend>tm_msgs</exec_depend>
  <exec_depend>vam_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
