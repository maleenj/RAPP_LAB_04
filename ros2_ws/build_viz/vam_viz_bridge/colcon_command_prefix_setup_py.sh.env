AMENT_PREFIX_PATH=/ws/ros2_ws/install/vam_viz_bridge:/ws/ros2_ws/install/vam_inference:/ws/ros2_ws/install/tm_teach_playback:/opt/ros/humble
CMAKE_PREFIX_PATH=/ws/ros2_ws/install/vam_interfaces
COLCON=1
COLCON_PREFIX_PATH=/ws/ros2_ws/install
DEBIAN_FRONTEND=noninteractive
HOME=/root
HOSTNAME=viz-container
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=/ws/ros2_ws/install/vam_interfaces/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/lib
OLDPWD=/ws
PATH=/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PKG_CONFIG_PATH=/ws/ros2_ws/install/vam_interfaces/lib/x86_64-linux-gnu/pkgconfig:/ws/ros2_ws/install/vam_interfaces/lib/pkgconfig
PWD=/ws/ros2_ws/build_viz/vam_viz_bridge
PYTHONPATH=/workspace/ros2_ws/build/vam_viz_bridge:/ws/ros2_ws/install/vam_viz_bridge/lib/python3.10/site-packages:/ws/ros2_ws/install/vam_inference/lib/python3.10/site-packages:/ws/ros2_ws/install/vam_interfaces/local/lib/python3.10/dist-packages:/ws/ros2_ws/install/tm_teach_playback/lib/python3.10/site-packages:/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
RCUTILS_COLORIZED_OUTPUT=1
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
ROS_PACKAGE_PATH=/ws/ros2_ws/install/vam_interfaces/share
ROS_PYTHON_VERSION=3
ROS_VERSION=2
SHLVL=0
TERM=xterm
_=/usr/bin/colcon
